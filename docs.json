              "roadphonepro/admin-menu",
              "roadphonepro/admin-menu-file-permissions",
              "roadphonepro/custom-upload",
              "roadphonepro/custom-music-api",
              "roadphonepro/gifs",
              "roadphonepro/standalone"
            ]
          },
          {
            "group": "RoadPhone",
            "pages": [
              "roadphone/installation",
              "roadphone/faq",
              "roadphone/commands",
              "roadphone/admin-menu",
              "roadphone/gifs",
              "roadphone/standalone",
              "roadphone/fivemanage"
            ]
          },
          {
            "group": "RoadPad",
            "pages": [
              "roadpad/installation",
              "roadpad/faq",
              "roadpad/custom-apps"
            ]
          },
          {
