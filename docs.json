    {
      "source": "/roadcarplay/commands",
      "destination": "/roadcarradio/commands"
    },
    {
      "source": "/roadcarplay/faq",
      "destination": "/roadcarradio/faq"
    },
    {
      "source": "/roadcarplay/api/client",
      "destination": "/roadcarradio/api/client"
    },
    {
      "source": "/roadcarplay/:slug*",
      "destination": "/roadcarradio/:slug*"
    }
  ]
