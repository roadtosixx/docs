          {
            "group": "RoadPhone",
            "pages": [
              "roadphone/api/client",
              "roadphone/api/server",
              "roadphone/api/clientevents",
              "roadphone/api/serverevents",
              "roadphone/api/callbacks"
            ]
          },
          {
            "group": "RoadPad",
            "pages": [
              "roadpad/api/client"
            ]
