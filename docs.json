        "groups": [
          {
            "group": "API documentation",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "RoadPhone Pro",
            "pages": [
              "roadphonepro/api/client",
              "roadphonepro/api/server",
              "roadphonepro/api/simcards",
              "roadphonepro/api/clientevents",
              "roadphonepro/api/serverevents",
              "roadphonepro/api/callbacks",
              "roadphonepro/api/metadata"
